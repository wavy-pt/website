---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, t } from '../i18n';
import { contactHref, CONTACT_EMAIL } from '../lib/env';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const isEn = lang === 'en';

const homePath = isEn ? '/en' : '/';
const ctaHref = contactHref(isEn ? '/en/contacto' : '/contacto');

// A 404 é pré-construída UMA vez. No build, Astro.url é /404, logo `lang` dá
// sempre 'pt' e o ramo inglês abaixo nunca era alcançado: um visitante que
// errasse um endereço em /en/ aterrava numa página em português, com os botões
// de saída a levá-lo para a home portuguesa — um beco sem saída para quem não
// percebe português.
//
// Não dá para resolver no build (é um ficheiro só para todas as rotas falhadas),
// por isso as duas versões vão no HTML e um script curto troca-as quando o
// endereço começa por /en. Sem JavaScript fica o português, como hoje.
const EN = {
  tag: 'Error 404',
  heading: 'This page got lost in the waves.',
  sub: 'The page you were looking for is not here. It might have moved, or the link you followed is no longer valid.',
  ctaPrimary: 'Back to home',
  ctaSecondary: 'Talk to Mariana',
  or: 'Or write to',
  home: '/en',
  contact: '/en/contacto',
};

const copy = isEn
  ? {
      tag: 'Error 404',
      heading: 'This page got lost in the waves.',
      sub: 'The page you were looking for is not here. It might have moved, or the link you followed is no longer valid.',
      ctaPrimary: 'Back to home',
      ctaSecondary: 'Talk to Mariana',
    }
  : {
      tag: 'Erro 404',
      heading: 'Esta página perdeu-se nas ondas.',
      sub: 'A página que procuras não está aqui. Pode ter sido movida, ou o link que seguiste já não é válido.',
      ctaPrimary: 'Voltar à página inicial',
      ctaSecondary: 'Falar com a Mariana',
    };
---

<Layout
  title={isEn ? '404 · Wavy' : '404 · Wavy'}
  description={copy.sub}
>
  <!-- <div> e não <main>: o Layout já abre o <main id="main-content">. -->
  <div class="min-h-screen flex items-center justify-center bg-offwhite px-6 pt-24 pb-16 relative overflow-hidden">
    {/* Subtle decorative background "404" */}
    <span
      aria-hidden="true"
      class="absolute inset-0 flex items-center justify-center font-serif text-[280px] md:text-[460px] lg:text-[560px] font-medium text-teal/5 leading-none select-none pointer-events-none"
    >
      404
    </span>

    <div class="relative text-center max-w-lg">
      <p class="font-sans text-xs uppercase tracking-[0.3em] text-teal-dark mb-5" data-en={EN.tag}>
        {copy.tag}
      </p>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-medium text-teal-dark mb-5 leading-[1.1]">
        <span data-en={EN.heading}>{copy.heading}</span>
      </h1>
      <p class="font-sans text-base md:text-lg text-muted mb-10 leading-relaxed">
        <span data-en={EN.sub}>{copy.sub}</span>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
        <a
          href={homePath}
          data-en-href={EN.home}
          class="inline-flex items-center gap-2 font-sans font-medium text-sm px-7 py-3.5 rounded-full bg-teal text-white hover:bg-teal-deep transition-all duration-300 group"
        >
          <i class="ri-arrow-left-line transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true"></i>
          <span data-en={EN.ctaPrimary}>{copy.ctaPrimary}</span>
        </a>
        <a
          href={ctaHref}
          data-en-href={EN.contact}
          class="inline-flex items-center gap-2 font-sans font-medium text-sm px-7 py-3.5 rounded-full border border-teal-deep/15 text-teal-dark hover:border-teal-deep hover:bg-teal-deep/5 transition-all duration-300"
        >
          <i class="ri-mail-line" aria-hidden="true"></i>
          <span data-en={EN.ctaSecondary}>{copy.ctaSecondary}</span>
        </a>
      </div>

      <p class="font-serif italic text-sm text-muted/70 mt-10">
        <span data-en={EN.or}>{isEn ? 'Or write to' : 'Ou escreve para'}</span>
        {' '}
        <a href={`mailto:${CONTACT_EMAIL}`} class="text-teal-deep hover:text-teal-dark transition-colors">
          {CONTACT_EMAIL}
        </a>
      </p>
    </div>
  </div>

  {/* Troca para inglês quando o endereço pedido está em /en. `is:inline` para
      correr já, antes de a pessoa ler o texto errado. */}
  <script is:inline>
    (function () {
      var p = location.pathname;
      if (p !== '/en' && p.indexOf('/en/') !== 0) return;
      document.documentElement.lang = 'en';
      document.querySelectorAll('[data-en]').forEach(function (el) {
        el.textContent = el.getAttribute('data-en');
      });
      document.querySelectorAll('[data-en-href]').forEach(function (el) {
        el.setAttribute('href', el.getAttribute('data-en-href'));
      });
    })();
  </script>
</Layout>
