---
import Layout from '../../layouts/Layout.astro';
import { CASOS_PUBLICADOS } from '../../lib/paginas-md';
import ScrollReveal from '../../components/ScrollReveal.astro';
import CasesHero from '../../components/cases/CasesHero.astro';
import CasesTransparency from '../../components/cases/CasesTransparency.astro';
import CaseStudy from '../../components/cases/CaseStudy.astro';
import CasesCta from '../../components/cases/CasesCta.astro';
---

<Layout
  title="Cases · Real Digital Transformations | Wavy"
  description="Two real digital direction projects, from X-Ray to result: the brand renewal for Vera Barata and the identity built from scratch for ADDS, with numbers."
>
  <CasesHero lang="en" />
  <CasesTransparency lang="en" />
  {Array.from({ length: CASOS_PUBLICADOS }, (_, i) => (
    <CaseStudy lang="en" index={i} />
  ))}
  <CasesCta lang="en" />
  <ScrollReveal />
</Layout>
