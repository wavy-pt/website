---
/**
 * Schema.org structured data for Wavy.
 * Emits a JSON-LD <script> tag so search engines AND generative engines
 * (Google AI Overviews, ChatGPT, Perplexity, etc.) understand what the
 * business is, where it operates, who runs it, and what it offers.
 *
 * Usa @graph para ligar a Organização, os Serviços e o WebSite numa só
 * estrutura coerente (entidade clara = melhor SEO local + GEO/AIO).
 *
 * RECEBE O IDIOMA. Antes não recebia, e as cinco páginas inglesas entregavam
 * aos motores e aos assistentes de IA uma ficha inteiramente em português —
 * serviços chamados "O Raio-X", "A Obra" e "A Direção", a apontar para as
 * páginas PT. Quem respondesse em inglês citava nomes portugueses e mandava o
 * leitor para páginas que não sabia ler.
 *
 * Os nomes dos serviços vêm do i18n, não escritos aqui: é a mesma fonte que a
 * página mostra, logo não podem divergir. Os campos que são metadados de
 * pesquisa (knowsAbout, alternateName) não existem no i18n e ficam aqui, com
 * versão nas duas línguas.
 */
import { t, getLocalizedPath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
const en = lang === 'en';
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://wavy.pt';

// Os três serviços, na ordem em que a página os apresenta. O nome e o subtítulo
// vêm do i18n; a frase curta vem da jornada, que é o que /servicos renderiza.
const jornada = i.servicesPage.journey.services;
const servicos = [i.services.start, i.services.boost, i.services.flow].map((s, idx) => ({
  nome: s.name,
  tipo: s.scriptName,
  descricao: [s.scriptName, jornada[idx]?.tagline].filter(Boolean).join('. ') + '.',
  url: `${site}${getLocalizedPath('/servicos', lang)}#servico-0${idx + 1}`,
}));

const organization = {
  '@type': 'ProfessionalService',
  // O @id é um identificador, não texto: tem de ser o MESMO nas duas línguas,
  // senão o Google passa a ver duas entidades diferentes em vez de uma.
  '@id': `${site}/#organization`,
  name: 'Wavy',
  alternateName: en ? 'Wavy, Digital Direction & Marketing' : 'Wavy, Direção e Marketing Digital',
  url: site,
  logo: `${site}/logo-wavy.svg`,
  image: `${site}/og-image.jpg`,
  description: en
    ? 'Digital direction and marketing for established businesses in West and Greater Lisbon. Strategy, websites, social media and local SEO.'
    : 'Direção e marketing digital para negócios com história, na Zona Oeste e Grande Lisboa. Estratégia, websites, redes sociais e SEO local.',
  founder: {
    '@type': 'Person',
    name: 'Mariana Antunes',
    jobTitle: en ? 'Founder and Director' : 'Fundadora e Diretora',
  },
  email: 'geral@wavy.pt',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mafra',
    addressRegion: 'Lisboa',
    addressCountry: 'PT',
  },
  // Topónimos: nomes próprios, não se traduzem.
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Mafra' },
    { '@type': 'AdministrativeArea', name: 'Samora Correia' },
    { '@type': 'Place', name: 'Zona Oeste' },
    { '@type': 'Place', name: 'Grande Lisboa' },
    { '@type': 'Country', name: 'Portugal' },
  ],
  knowsAbout: en
    ? [
        'Digital Marketing',
        'Digital Direction',
        'Digital Strategy',
        'Website Development',
        'Social Media Management',
        'Local SEO',
        'Google Business Profile',
        'Visual Identity',
      ]
    : [
        'Marketing Digital',
        'Direção Digital',
        'Estratégia Digital',
        'Desenvolvimento de Websites',
        'Gestão de Redes Sociais',
        'SEO Local',
        'Google Business Profile',
        'Identidade Visual',
      ],
  serviceType: servicos.map((s) => s.tipo),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: en ? 'Wavy Services' : 'Serviços Wavy',
    itemListElement: servicos.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.nome,
        description: s.descricao,
        url: s.url,
      },
    })),
  },
  sameAs: [
    'https://instagram.com/wavy.digital.pt',
    'https://facebook.com/wavy.digital.pt',
  ],
  priceRange: '€€',
  inLanguage: ['pt-PT', 'en'],
};

const website = {
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'Wavy',
  description: en
    ? 'Digital direction and marketing for established businesses in West and Greater Lisbon.'
    : 'Direção e marketing digital para negócios com história, na Zona Oeste e Grande Lisboa.',
  inLanguage: ['pt-PT', 'en'],
  publisher: { '@id': `${site}/#organization` },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [organization, website],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
