---
/**
 * Cookie banner + Google Analytics 4 with Consent Mode v2.
 *
 * - Only renders in production AND when PUBLIC_GA_ID is set.
 * - GA4 loads only after the user explicitly accepts.
 * - Default consent state is "denied" (GDPR-friendly).
 * - The user's choice is stored in localStorage and respected on future visits.
 * - The footer can call `window.wavyOpenCookieSettings()` to re-open the banner.
 */
import { getLangFromUrl } from '../i18n';
import { isProd } from '../lib/env';

const gaId = import.meta.env.PUBLIC_GA_ID;
const enabled = isProd && Boolean(gaId);

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const privacyHref = isEn ? '/en/privacy' : '/privacidade';

const rotuloBanner = isEn ? 'Cookie consent' : 'Consentimento de cookies';

const copy = isEn
  ? {
      message:
        'We use cookies to understand how the site is used and improve it. Only with your consent.',
      accept: 'Accept',
      reject: 'Reject',
      learn: 'Privacy policy',
    }
  : {
      message:
        'Usamos cookies para perceber como o site é usado e melhorá-lo. Só com o teu consentimento.',
      accept: 'Aceitar',
      reject: 'Recusar',
      learn: 'Política de privacidade',
    };
---

{enabled && (
  <>
    {/* Pre-load Consent Mode defaults BEFORE GA loads.
        Importante: com is:inline o Astro NÃO processa o conteúdo, tem de
        ser JavaScript puro, sem template literal envolvente. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());
    </script>

    <div
      id="cookie-banner"
      role="dialog"
      aria-modal="false"
      aria-label={rotuloBanner}
      tabindex="-1"
      data-state="hidden"
      class="fixed bottom-4 left-4 right-4 md:bottom-6 md:left-1/2 md:right-auto md:-translate-x-1/2 md:max-w-2xl md:w-[calc(100%-3rem)] z-[70] data-[state=hidden]:hidden"
    >
      <div class="bg-teal-deep text-cream rounded-inner shadow-2xl p-6 md:p-8 border border-cream/10">
        <div class="flex flex-col md:flex-row md:items-center md:gap-8">
          <p class="font-sans text-sm md:text-base leading-relaxed mb-5 md:mb-0 md:flex-1">
            {copy.message}
          </p>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <button
              type="button"
              data-cookie-action="accept"
              class="inline-flex items-center justify-center font-sans text-sm font-medium px-6 py-2.5 rounded-full bg-cream text-teal-dark hover:bg-offwhite transition-colors whitespace-nowrap"
            >
              {copy.accept}
            </button>
            <button
              type="button"
              data-cookie-action="reject"
              class="inline-flex items-center justify-center font-sans text-sm font-medium px-6 py-2.5 rounded-full border border-cream/30 text-cream hover:bg-cream/10 transition-colors whitespace-nowrap"
            >
              {copy.reject}
            </button>
          </div>
        </div>
        <div class="mt-4 md:mt-3 md:pt-3 md:border-t md:border-cream/10">
          <a
            href={privacyHref}
            class="font-sans text-xs text-cream hover:text-cream underline underline-offset-2"
          >
            {copy.learn}
          </a>
        </div>
      </div>
    </div>

    <script define:vars={{ gaId }}>
      const STORAGE_KEY = 'wavy-cookie-consent';

      function safeGtag() {
        if (typeof window.gtag === 'function') {
          window.gtag.apply(window, arguments);
        }
      }

      function loadGa() {
        if (document.querySelector('script[data-ga="loaded"]')) return;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        s.dataset.ga = 'loaded';
        document.head.appendChild(s);
        // Sem `anonymize_ip`: é um parâmetro do Universal Analytics que o GA4
        // ignora (a documentação do Google di-lo). Dava a impressão de uma
        // protecção que não vem daí — o que protege é o GA4 já não guardar o
        // IP por omissão. Tirado para o código não prometer o que não faz,
        // agora que a política passou a dizer "pseudonimizados".
        safeGtag('config', gaId);
      }

      function setBannerState(state) {
        const el = document.getElementById('cookie-banner');
        if (!el) return;
        el.dataset.state = state;
        // Levar o foco até ao pedido de consentimento. Sem isto, quem navega
        // com teclado só lá chegava depois de percorrer a página inteira, e
        // quem usa leitor de ecrã não era avisado de que tinha aparecido.
        if (state === 'visible') {
          try { el.focus({ preventScroll: true }); } catch (_) { el.focus(); }
        }
      }

      // M#9 — o RGPD diz que retirar o consentimento tem de ser tão fácil como
      // dá-lo. Não era: quem aceitava e depois se arrependia ficava com o
      // identificador do Google no computador até dois anos. O sinal de
      // consentimento mudava, os cookies ficavam.
      function apagarCookiesDoGoogle() {
        var nomes = [];
        document.cookie.split(';').forEach(function (c) {
          var nome = c.split('=')[0].trim();
          if (/^_ga/.test(nome) || /^_gid$/.test(nome) || /^_gat/.test(nome)) nomes.push(nome);
        });
        if (!nomes.length) return;

        // Um cookie só é apagado se acertarmos no par domínio+caminho com que
        // foi escrito, e daqui não se sabe qual foi. O Google usa o domínio
        // raiz (wavy.pt) com ponto inicial, mas em localhost e em preview é
        // outro — por isso tenta-se toda a hierarquia, com e sem ponto.
        var partes = location.hostname.split('.');
        var dominios = [null];
        for (var i = 0; i < partes.length - 1; i++) {
          var d = partes.slice(i).join('.');
          dominios.push(d, '.' + d);
        }
        nomes.forEach(function (nome) {
          dominios.forEach(function (d) {
            document.cookie = nome + '=; max-age=0; path=/' + (d ? '; domain=' + d : '');
          });
        });
      }

      function applyConsent(value) {
        try {
          localStorage.setItem(STORAGE_KEY, value);
        } catch (_) {
          // localStorage pode falhar em modo privado de alguns browsers
        }
        if (value === 'accepted') {
          safeGtag('consent', 'update', { analytics_storage: 'granted' });
          loadGa();
        } else {
          safeGtag('consent', 'update', { analytics_storage: 'denied' });
          apagarCookiesDoGoogle();
        }
        setBannerState('hidden');
      }

      function init() {
        const banner = document.getElementById('cookie-banner');
        if (!banner) return;

        // Initial state — mostrar banner se ainda não houve escolha
        let stored = null;
        try { stored = localStorage.getItem(STORAGE_KEY); } catch (_) {}

        if (stored === 'accepted') {
          safeGtag('consent', 'update', { analytics_storage: 'granted' });
          loadGa();
        } else if (stored === 'rejected') {
          // Already declined — banner fica hidden
        } else {
          setBannerState('visible');
        }

        // Wire up buttons via event delegation
        banner.addEventListener('click', function (e) {
          const target = e.target instanceof Element ? e.target : null;
          if (!target) return;
          const btn = target.closest('[data-cookie-action]');
          if (!btn) return;
          const action = btn.getAttribute('data-cookie-action');
          if (action === 'accept') applyConsent('accepted');
          else if (action === 'reject') applyConsent('rejected');
        });

        // Expose a global helper so the footer can re-open the banner
        window.wavyOpenCookieSettings = function () {
          try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
          // Enquanto o banner está aberto à espera de nova escolha, o estado
          // volta ao seguro. Antes, quem clicasse em "Gerir cookies" e fechasse
          // o separador sem escolher continuava com o Analytics a correr nessa
          // visita, como se não tivesse mexido em nada.
          safeGtag('consent', 'update', { analytics_storage: 'denied' });
          setBannerState('visible');
        };

        // OBS#6/26 — o "Gerir cookies" do rodapé era um <button> com onclick
        // que, se esta função não existisse (Analytics não configurado, chave
        // mal copiada, JavaScript desligado), não fazia absolutamente nada:
        // sem erro, sem aviso, e é o botão que uma pessoa carrega quando está
        // a tentar exercer um direito. Agora é um link para a política, que o
        // script intercepta quando há mesmo banner para abrir. Falha para o
        // lado seguro.
        // Sem role="button": o elemento TEM destino real e continua a ser um
        // link — o script só melhora a experiência abrindo o banner em vez de
        // navegar. Anunciá-lo como botão obrigaria a responder também à barra
        // de espaços, que os links não fazem, e ficava pior do que está.
        document.querySelectorAll('[data-cookie-settings]').forEach(function (el) {
          el.addEventListener('click', function (e) {
            e.preventDefault();
            window.wavyOpenCookieSettings();
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    </script>
  </>
)}
