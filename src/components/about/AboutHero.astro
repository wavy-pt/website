---
import { t } from '../../i18n';
import type { Lang } from '../../i18n';
import MarqueeCard from './MarqueeCard.astro';
import type { CartaoMarquee } from './marquee';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang).aboutPage.hero;

const items = i.marquee as readonly CartaoMarquee[];
const row1 = items.slice(0, 5);
const row2 = items.slice(5, 10);
---

<section class="bg-offwhite pt-16 md:pt-[72px] min-h-screen flex flex-col overflow-hidden">
  <!-- Texto no topo, centrado -->
  <!-- Sem `scroll-reveal` de propósito: este bloco é o primeiro ecrã, e a
       classe punha o título a opacity:0 até o JavaScript correr. A home e
       /servicos já eram assim; isto alinha as restantes. -->
  <div class="max-w-3xl mx-auto w-full px-6 md:px-10 pt-10 md:pt-16 text-center">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-teal-deep mb-6 flex items-center justify-center gap-3">
      <span class="w-8 h-px bg-teal" aria-hidden="true"></span>
      {i.tag}
    </p>

    <div class="flex flex-col gap-4">
      <h1 class="font-serif text-[2.25rem] sm:text-4xl md:text-5xl lg:text-6xl font-medium text-teal-dark leading-[1.1] text-balance">
        {i.headline.replace(/ (\S+)$/, ' $1')}
        {' '}<em class="text-teal font-serif italic font-medium">{i.headlineHighlight}</em>
      </h1>
      <p class="font-sans text-base md:text-lg text-muted leading-relaxed max-w-xl mx-auto">
        {i.subtitle}
      </p>
    </div>
  </div>

  <!-- Cards no fundo, full-width, a ocupar o espaço restante -->
  <div class="flex-1 flex flex-col justify-center overflow-hidden py-8 md:py-12">
    <!-- Row 1: animate-marquee-left -->
    {/* aria-hidden e alt vazio de propósito: os cartões estão duplicados para o
        efeito de rolagem infinita, e descrevê-los faria um leitor de ecrã ouvir
        a mesma coisa duas vezes. O conteúdo real da página está a seguir. */}
    <div aria-hidden="true" class="flex gap-4 md:gap-5 mb-3 md:mb-4 w-max animate-marquee-left">
      {[...row1, ...row1].map((item) => <MarqueeCard item={item} />)}
    </div>

    <!-- Row 2: animate-marquee-right -->
    <div aria-hidden="true" class="flex gap-4 md:gap-5 w-max animate-marquee-right">
      {[...row2, ...row2].map((item) => <MarqueeCard item={item} />)}
    </div>
  </div>
</section>
