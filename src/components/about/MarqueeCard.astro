---
/**
 * Um cartão do carrossel decorativo de /sobre.
 *
 * Estava escrito duas vezes no AboutHero — 34 linhas idênticas, uma por fila,
 * diferindo só no nome do array. Quem corrigisse um espaçamento numa e não
 * reparasse na outra deixava metade da animação diferente da outra, e o build
 * não se queixava.
 *
 * O tipo era `any` (o único de todo o projeto), o que desligava a verificação
 * precisamente onde os dados misturam três formatos de cartão e trazem um campo
 * booleano. Agora é discriminado por `type`: escrever `{item.small}` em vez de
 * o usar como condição passa a dar erro de compilação em vez de imprimir "true"
 * no ecrã.
 */
import { Image } from 'astro:assets';
import heroImage from '../../assets/wavy-hero.jpg';
import bastidoresImage from '../../assets/wavy-bastidores.jpg';
import type { CartaoMarquee, CorCartao } from './marquee';

interface Props {
  item: CartaoMarquee;
}

const { item } = Astro.props;

const imageMap = { hero: heroImage, bastidores: bastidoresImage } as const;

const colorMap: Record<CorCartao, { bg: string; text: string; labelText: string; numberText: string; bodyText: string; border: string }> = {
  cream: {
    bg: 'bg-cream',
    text: 'text-teal-dark',
    labelText: 'text-teal/70',
    numberText: 'text-teal',
    bodyText: 'text-muted',
    border: 'border border-teal/10',
  },
  teal: {
    bg: 'bg-teal-panel',
    text: 'text-cream',
    labelText: 'text-cream',
    numberText: 'text-cream',
    bodyText: 'text-cream',
    border: '',
  },
  'teal-deep': {
    bg: 'bg-teal-deep',
    text: 'text-cream',
    labelText: 'text-cream',
    numberText: 'text-cream',
    bodyText: 'text-cream',
    border: '',
  },
};

const c = colorMap[item.cardColor || 'cream'];
---

{item.type === 'image' && (
  <div class="shrink-0 w-52 sm:w-60 md:w-72 lg:w-80 h-44 sm:h-48 md:h-52 lg:h-56 rounded-inner overflow-hidden relative">
    <Image
      src={imageMap[item.imageKey || 'bastidores']}
      alt=""
      class="w-full h-full object-cover object-center"
      loading="lazy"
      widths={[320, 480, 640]}
      width={640}
      sizes="320px"
      quality={75}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" aria-hidden="true"></div>
  </div>
)}

{item.type === 'stat' && (
  <div class:list={[
    'shrink-0 w-48 sm:w-52 md:w-60 lg:w-64 h-44 sm:h-48 md:h-52 lg:h-56 rounded-inner flex flex-col justify-end p-4 sm:p-5 md:p-6',
    c.bg, c.text, c.border,
  ]}>
    <span class:list={['font-sans eyebrow mb-2', c.labelText]}>{item.label}</span>
    <span class:list={[item.small ? 'font-serif text-lg sm:text-xl md:text-2xl font-medium leading-tight' : 'font-serif text-3xl sm:text-4xl md:text-5xl font-medium', c.numberText]}>{item.number}</span>
    {item.sublabel && (
      <span class:list={['font-sans text-[10px] sm:text-xs leading-snug mt-1.5', c.bodyText]}>{item.sublabel}</span>
    )}
  </div>
)}

{item.type === 'text' && (
  <div class:list={[
    'shrink-0 w-44 sm:w-52 md:w-64 lg:w-72 h-44 sm:h-48 md:h-52 lg:h-56 rounded-inner flex flex-col justify-end p-4 sm:p-5 md:p-6',
    c.bg, c.text, c.border,
  ]}>
    <p class="font-serif text-base sm:text-lg md:text-xl font-medium mb-1">{item.title}</p>
    <p class:list={['font-sans text-xs md:text-sm leading-relaxed', c.bodyText]}>{item.body}</p>
  </div>
)}
